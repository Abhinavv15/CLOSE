# Database configuration (PostgreSQL for prod, SQLite supported for local development)
DATABASE_URL=sqlite:///./close.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/close_finance

# Supabase configuration (optional / managed auth & storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=financial-uploads

# AI Controller configuration
# Options: 'mock' (deterministic, ground-truth backed, offline) or 'live' (real LLM API)
AI_MODE=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-pro

# Confidence thresholds (Sections 24)
CONFIDENCE_THRESHOLD_AUTO_RESOLVE=0.95
CONFIDENCE_THRESHOLD_RECOMMEND=0.85
CONFIDENCE_THRESHOLD_REVIEW=0.60

# Redis configuration (optional for job queues)
REDIS_URL=redis://localhost:6379/0

# Application URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
